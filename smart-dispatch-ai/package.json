{
  "name": "smart-dispatch-ai",
  "version": "1.0.0",
  "description": "粵語 AI 智能接線及派單系統",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test-call": "ts-node --project tsconfig.json scripts/test-call.ts",
    "test-call:auto": "ts-node --project tsconfig.json scripts/test-call.ts --auto",
    "db:init": "ts-node src/db/store.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@google-cloud/speech": "^6.7.0",
    "@google-cloud/text-to-speech": "^5.5.0",
    "better-sqlite3": "^11.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-ws": "^5.0.2",
    "readline": "^1.3.0",
    "twilio": "^5.4.5",
    "uuid": "^11.1.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/express-ws": "^3.0.5",
    "@types/node": "^22.13.14",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
